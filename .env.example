# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- OpenRouter (chat completions) ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_APP_URL=https://petroconnect.app
OPENROUTER_APP_NAME=PetroConnect

# --- Embeddings (semantic search, recommendations, dedupe, pricing) ---
# Either provider works. If both are set, OpenAI is used (cheaper).
# Leave both blank to disable semantic features; the app falls back to FTS.
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=openai/text-embedding-3-small

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Admin bootstrap (comma-separated emails) ---
ADMIN_EMAILS=admin@kpc.com.kw
